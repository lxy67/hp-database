# Server Configuration
PORT=3000
JWT_SECRET=your_secure_jwt_secret_key_change_in_production

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hpdata
DB_USER=postgres
DB_PASSWORD=your_secure_password

# Email Configuration (for account verification)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_SECURE=false  # true for 465, false for other ports
EMAIL_USER=your-email@example.com
EMAIL_PASS=your-email-password

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100

# Production Database URL (for Zeabur)
# Uncomment and update this in production
# DATABASE_URL=postgresql://username:password@host:port/dbname

# Session Secret (for production)
SESSION_SECRET=your_session_secret_key

# CORS Configuration (for production)
CORS_ORIGIN=https://your-frontend-domain.com

# Logging
LOG_LEVEL=info  # error, warn, info, debug
