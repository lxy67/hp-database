{
    "buildCommand": "npm install",
    "installCommand": "npm install",
    "buildCommandArgs": [],
    "devCommand": "npm run dev",
    "outputDirectory": "public",
    "framework": "node",
    "routes": [
        {
            "src": "/api/.*",
            "dest": "/api"
        },
        {
            "src": "/.*",
            "dest": "/index.html"
        }
    ],
    "env": {
        "NODE_ENV": "production"
    },
    "builds": [
        {
            "src": "server.js",
            "use": "@vercel/node"
        },
        {
            "src": "public/**/*",
            "use": "@vercel/static"
        }
    ]
}