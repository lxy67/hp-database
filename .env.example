# Database Configuration
# Zeabur will auto-inject these in production. Do NOT put real secrets here.
# They are shown here only as documentation for local development if needed.
# POSTGRES_HOST=
# POSTGRES_PORT=5432
# POSTGRES_USERNAME=
# POSTGRES_PASSWORD=
# POSTGRES_DATABASE=
# Optional fallback host variable exposed by Zeabur in some setups:
# HP_DATABASE_HOST=

# Server Configuration
PORT=3000
JWT_SECRET=your_secure_jwt_secret_here
NODE_ENV=development

# Notes:
# - On Zeabur, database credentials are auto-generated and injected as env vars.
# - This app reads POSTGRES_HOST/PORT/USERNAME/PASSWORD/DATABASE (and optionally HP_DATABASE_HOST).
# - Do not set localhost DB values; use the Zeabur-provided values.
